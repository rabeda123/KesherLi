# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kesharli
# 32+ random characters. Generate with: openssl rand -base64 48
APP_SECRET=
# Comma-separated origins allowed to call the API (the Expo web dev server by default).
CORS_ORIGINS=http://localhost:8081
# Base URL for invitation links sent to contacts.
PUBLIC_APP_URL=http://localhost:8081

# SMS: "console" writes codes to the server log (development only, refused in production).
SMS_PROVIDER=console
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Push: "none" or "expo" (Expo push service → APNs/FCM; needs an EAS build with push credentials).
PUSH_PROVIDER=none
# EXPO_ACCESS_TOKEN=

# Development only: include one-time codes in API responses so the app can be tried without SMS.
DEV_EXPOSE_OTP=false

# Requests per minute per IP across the API (0 disables). Set TRUST_PROXY=true behind a load balancer.
GLOBAL_RATE_LIMIT_PER_MIN=600
TRUST_PROXY=false
