{
  "expo": {
    "name": "קשרלי",
    "slug": "kesharli",
    "scheme": "kesharli",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kesharli.app"
    },
    "android": {
      "package": "com.kesharli.app",
      "adaptiveIcon": {
        "backgroundColor": "#E8F6F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "קשרלי צריכה גישה למצלמה כדי לקיים שיחות וידאו",
          "microphonePermission": "קשרלי צריכה גישה למיקרופון כדי לקיים שיחות קוליות ושיחות וידאו"
        }
      ]
    ]
  }
}
